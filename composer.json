{
    "name": "gamedev/academy",
    "description": "Plataforma de cursos online gamificada para desenvolvimento de jogos",
    "type": "project",
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "GameDev Academy",
            "email": "contato@gamedev.academy"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ckeditor/ckeditor": "^4.25",
        "cocur/slugify": "^4.4",
        "composer/installers": "^2.2",
        "firebase/php-jwt": "^6.8",
        "guzzlehttp/guzzle": "^7.8",
        "intervention/image": "^2.7",
        "league/plates": "^3.5",
        "monolog/monolog": "^3.4",
        "nesbot/carbon": "^2.69",
        "nikic/fast-route": "^1.3",
        "npm-asset/editorjs--editorjs": "^2.28",
        "npm-asset/editorjs--header": "^2.7",
        "npm-asset/editorjs--paragraph": "^2.11",
        "npm-asset/editorjs--list": "^1.9",
        "npm-asset/editorjs--code": "^2.8",
        "npm-asset/editorjs--image": "^2.8",
        "npm-asset/editorjs--embed": "^2.5",
        "npm-asset/editorjs--table": "^2.2",
        "npm-asset/editorjs--checklist": "^1.5",
        "oomphinc/composer-installers-extender": "^2.0",
        "phpmailer/phpmailer": "^7.0",
        "ramsey/uuid": "^4.7",
        "respect/validation": "^2.2",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "symfony/var-dumper": "^6.3",
        "phpunit/phpunit": "^10.3",
        "fakerphp/faker": "^1.23"
    },
    "extra": {
        "installer-types": ["npm-asset"],
        "installer-paths": {
            "assets/js/editorjs/": ["npm-asset/editorjs--editorjs"],
            "assets/js/editorjs/plugins/{$name}/": [
                "npm-asset/editorjs--header",
                "npm-asset/editorjs--paragraph",
                "npm-asset/editorjs--list",
                "npm-asset/editorjs--code",
                "npm-asset/editorjs--image",
                "npm-asset/editorjs--embed",
                "npm-asset/editorjs--table",
                "npm-asset/editorjs--checklist"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php scripts/setup-editorjs.php"
        ],
        "post-update-cmd": [
            "@php scripts/setup-editorjs.php"
        ],
        "test": "phpunit",
        "migrate": "php database/migrate.php"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "oomphinc/composer-installers-extender": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}